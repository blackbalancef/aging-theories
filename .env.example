# Aging Research Service - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# REQUIRED: AI Model Configuration
# ============================================================================
# Nebius AI Studio API key (required for classification and analysis)
# Get your key at: https://nebius.com/
NEBIUS_API_KEY=your_nebius_api_key_here

# Optional: override default Nebius chat model (8B is safest default)
LLM_DEFAULT_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
# Optionally customize individual agents/models (leave blank to inherit default)
DISCOVERY_LLM_MODEL=
ANALYSIS_LLM_MODEL=
THEORY_LLM_MODEL=

# ============================================================================
# REQUIRED: PubMed/PMC Configuration
# ============================================================================
# NCBI E-utilities API credentials (required for PubMed/PMC crawlers)
# Get your API key at: https://account.ncbi.nlm.nih.gov/
NCBI_EMAIL=your@email.com
NCBI_API_KEY=your_ncbi_api_key_here

# Alternative names (will use NCBI credentials if not provided)
PUBMED_EMAIL=your@email.com
PUBMED_API_KEY=your_pubmed_api_key_here
PMC_EMAIL=your@email.com
PMC_API_KEY=your_pmc_api_key_here

# ============================================================================
# OPTIONAL: Additional Data Sources
# ============================================================================
# Scopus API token
SCOPUS_TOKEN=your_scopus_token_here

# Nature Publishing Group
NATURE_EMAIL=your@email.com

# ============================================================================
# Database Configuration
# ============================================================================
# PostgreSQL connection string (default works with docker-compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aging_research

# ============================================================================
# Redis Configuration
# ============================================================================
# Redis connection string (default works with docker-compose)
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_NAME=aging_research:article_analysis

# ============================================================================
# Service Configuration
# ============================================================================
# Directory for storing downloaded PDFs
PDF_STORAGE_PATH=data/pdfs

# Maximum concurrent analyses
MAX_CONCURRENT_ANALYSES=3

# Worker poll interval (seconds)
WORKER_POLL_INTERVAL=5

# ============================================================================
# Theory Classification Configuration
# ============================================================================
# Note: Theory classification now uses LLM for intelligent matching instead of embeddings
# LLM analyzes conceptual similarity between theories for better accuracy

# ============================================================================
# Optional: Advanced Agent Configuration
# ============================================================================
# Tavily API key for web search (optional, used by agents for additional research)
TAVILY_API_KEY=
